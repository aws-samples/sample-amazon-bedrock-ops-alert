#
# Example terraform.tfvars — copy to terraform.tfvars and update values
# Equivalent to CloudFormation --parameters in the deploy command

# --- General Configuration ---
customer_name          = "AcmeCorp"
stakeholder_email_list = ["email1@example.com", "email2@example.com"]
notification_preference = "all"

# --- Lambda Deployment Configuration ---
lambda_s3_bucket = "your-deployment-bucket"

# --- Model Specification ---
bedrock_model_name             = "G-Opus-4-6"
inference_profile_type         = "System-Defined"
bedrock_model_id               = "global.anthropic.claude-opus-4-6-v1"
geo_data_residency_requirement = "No"
input_modalities               = "TEXT and IMAGE"

# --- Model Quota Configuration ---
requests_per_minute_quota_code       = "L-3DD46812"
requests_per_minute_increase_percent = 25
tokens_per_minute_quota_code         = "L-3DCCFAA4"
tokens_per_minute_increase_percent   = 25

# --- Model Usage Budget (Threshold) ---
requests_per_minute_threshold_percent = 80
tokens_per_minute_threshold_percent   = 80
latency_threshold_ms                  = 240000

# --- Automated Support Case Configuration ---
enable_automated_support_case = "Yes"
support_case_lookback_days    = 60
use_case_description          = "Enterprise production workload serving real-time AI-powered features to end users."

# --- Automated Threshold Update Configuration ---
enable_automated_threshold_update       = "Yes"
threshold_update_schedule_interval_days = 1

# --- Layer 1: Critical Error Detection ---
error_threshold                  = 5
critical_alarm_evaluation_periods = 5

# --- Layer 2: Usage Rate Monitoring ---
warning_alarm_evaluation_periods = 5
latency_alarm_period             = 300
latency_alarm_evaluation_periods = 2

# --- Layer 3: Anomaly Detection ---
anomaly_detection_period   = 300
anomaly_evaluation_periods = 12
anomaly_sensitivity        = 9

# --- Common Alarm Configuration ---
alarm_evaluation_period = 60
